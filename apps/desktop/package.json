{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Менеджер сесій рольової гри (гейммайстер)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:server": "esbuild ../server/src/index.ts --bundle --platform=node --format=cjs --outfile=../server/dist/server.cjs",
    "watch:server": "npm run build:server -- --watch",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-builder"
  },
  "dependencies": {
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wilmak/shared": "*",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.23.1",
    "sass": "^1.101.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "trpg.witcher.gm",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../server/dist/server.cjs",
        "to": "server/server.cjs"
      },
      {
        "from": "../player-web/dist",
        "to": "player-web"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.role-playing-games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  }
}
